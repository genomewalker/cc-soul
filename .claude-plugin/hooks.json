{
  "description": "cc-soul hooks for persistent memory and realm-scoped recall",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/subconscious.sh start",
            "statusMessage": "awakening…"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/simple-hook.sh start",
            "statusMessage": "recalling context…"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/auto-index.sh",
            "statusMessage": "sensing codebase…",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/simple-hook.sh prompt",
            "statusMessage": "resonating…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/simple-hook.sh stop",
            "statusMessage": "preserving state…"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/simple-hook.sh pre-compact",
            "statusMessage": "consolidating memory…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/simple-hook.sh pre-tool Read",
            "timeout": 5,
            "statusMessage": "gathering context…"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/simple-hook.sh pre-tool Edit",
            "timeout": 5,
            "statusMessage": "checking patterns…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/simple-hook.sh post-tool Edit",
            "timeout": 5,
            "statusMessage": "noting changes…",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/simple-hook.sh post-failure",
            "timeout": 5,
            "statusMessage": "learning from error…"
          }
        ]
      }
    ]
  }
}
